{
  "test_id": "disturbance",
  "description": "At the ambient peak (about 6 h, 35 C) the room still holds -20 C and EER drops to about 3.5.",
  "fmus": {"weather": "weather.fmu", "coldroom": "coldroom.fmu", "controller": "controller.bin", "energy_meter": "energy_meter.bin"},
  "simulation_parameters": {"start_time": 0, "stop_time": 108000, "step_size": 10},
  "initial_parameter_overrides": {"coldroom": {"T0": 253.15}},
  "assertions": [
    {"time": 21600, "variable": "weather.T_amb", "operator": "greater_than", "expected": 307.9, "message": "Ambient is at its 35 C peak"},
    {"time": 21600, "variable": "coldroom.T_room_C", "operator": "less_than", "expected": -18.5, "message": "Room holds temperature at peak ambient"},
    {"time": 21600, "variable": "coldroom.T_room_C", "operator": "greater_than", "expected": -21.5, "message": "Room not overcooled at peak"},
    {"time": 21600, "variable": "coldroom.EER", "operator": "less_than", "expected": 3.6, "message": "EER at the 35 C peak is about 3.5"},
    {"time": 21600, "variable": "coldroom.EER", "operator": "greater_than", "expected": 3.45, "message": "EER at the 35 C peak is about 3.5"}
  ]
}
