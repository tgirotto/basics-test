{
  "test_id": "setpoint_step",
  "description": "Step: ambient mean raised to 35 C with no swing; room still holds -20 C.",
  "fmus": {"weather": "weather.fmu", "coldroom": "coldroom.fmu", "controller": "controller.bin"},
  "simulation_parameters": {"start_time": 0, "stop_time": 86400, "step_size": 10},
  "initial_parameter_overrides": {"coldroom": {"T0": 253.15}, "weather": {"T_mean": 308.15, "T_amp": 0}},
  "input_scenario": [],
  "assertions": [
    {"time": 86400, "variable": "weather.T_amb", "operator": "greater_than", "expected": 308.0, "message": "Ambient stays at 35 C"},
    {"time": 86400, "variable": "coldroom.T_room_C", "operator": "less_than", "expected": -18.5, "message": "Room holds below -18.5 C at constant 35 C ambient"}
  ]
}
