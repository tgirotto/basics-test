{
  "modules": [
    {
      "name": "weather",
      "kind": "modelica",
      "path": "weather.mo",
      "role": "Sinusoidal ambient temperature 15-35 C, 24 h period",
      "ports": [
        {
          "name": "T_amb",
          "causality": "output",
          "description": "Ambient temperature [K]"
        }
      ]
    },
    {
      "name": "coldroom",
      "kind": "modelica",
      "path": "coldroom.mo",
      "role": "Insulated cold room thermal plant (UA = 20 W/K) with refrigeration; EER 4.5 at 25 C ambient, 3.5 at 35 C ambient",
      "ports": [
        {
          "name": "T_amb",
          "causality": "input",
          "description": "Ambient temperature [K]"
        },
        {
          "name": "cooling_cmd",
          "causality": "input",
          "description": "Compressor command 0..1"
        },
        {
          "name": "T_room",
          "causality": "output",
          "description": "Room temperature [K]"
        },
        {
          "name": "T_room_C",
          "causality": "output",
          "description": "Room temperature [C]"
        },
        {
          "name": "Q_wall",
          "causality": "output",
          "description": "Wall heat gain [W]"
        },
        {
          "name": "Q_cool",
          "causality": "output",
          "description": "Refrigeration power removed [W]"
        },
        {
          "name": "EER",
          "causality": "output",
          "description": "Energy efficiency ratio [-]"
        },
        {
          "name": "P_el",
          "causality": "output",
          "description": "Compressor electrical power [W]"
        }
      ]
    },
    {
      "name": "controller",
      "kind": "structured_text",
      "path": "controller.st",
      "role": "Hysteresis thermostat holding -20 C",
      "ports": [
        {
          "name": "T_room",
          "causality": "input",
          "description": "Room temperature [K]"
        },
        {
          "name": "cooling_cmd",
          "causality": "output",
          "description": "Compressor command 0..1"
        }
      ]
    },
    {
      "name": "energy_meter",
      "kind": "structured_text",
      "path": "energy_meter.st",
      "role": "Monitor: receives EER and P_el from coldroom so they are logged as series; integrates compressor electrical energy",
      "ports": [
        {
          "name": "EER_in",
          "causality": "input",
          "description": "Energy efficiency ratio [-]"
        },
        {
          "name": "P_el_in",
          "causality": "input",
          "description": "Compressor electrical power [W]"
        },
        {
          "name": "EER_out",
          "causality": "output",
          "description": "EER pass-through [-]"
        },
        {
          "name": "P_el_out",
          "causality": "output",
          "description": "Electrical power pass-through [W]"
        },
        {
          "name": "E_el_kWh",
          "causality": "output",
          "description": "Accumulated compressor electrical energy [kWh]"
        }
      ]
    }
  ],
  "connections": [
    {
      "source": "weather",
      "source_port": "T_amb",
      "target": "coldroom",
      "target_port": "T_amb"
    },
    {
      "source": "coldroom",
      "source_port": "T_room",
      "target": "controller",
      "target_port": "T_room"
    },
    {
      "source": "controller",
      "source_port": "cooling_cmd",
      "target": "coldroom",
      "target_port": "cooling_cmd"
    },
    {
      "source": "coldroom",
      "source_port": "EER",
      "target": "energy_meter",
      "target_port": "EER_in"
    },
    {
      "source": "coldroom",
      "source_port": "P_el",
      "target": "energy_meter",
      "target_port": "P_el_in"
    }
  ]
}